<script>
(function(){
  var pages=[].slice.call(document.querySelectorAll('.page'));
  var links=[].slice.call(document.querySelectorAll('nav ul a'));
  function route(first){
    var r=(location.hash||'').replace(/^#\/?/,'');
    var cur=pages.filter(function(p){return p.dataset.r===r})[0]||pages[0];
    pages.forEach(function(p){p.classList.toggle('on',p===cur)});
    links.forEach(function(a){a.dataset.r===cur.dataset.r?a.setAttribute('aria-current','page'):a.removeAttribute('aria-current')});
    document.title=cur.dataset.t;
    window.scrollTo(0,0);
    if(!first){var h=cur.querySelector('h1,h2');if(h)h.focus({preventScroll:true});}
  }
  window.addEventListener('hashchange',function(){route(false)});
  route(true);
})();
</script>
